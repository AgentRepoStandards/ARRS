{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/1/capability-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "identity",
    "status",
    "query",
    "affectedFeatureIds",
    "effectiveRisk",
    "verificationTargets",
    "nodes",
    "edges",
    "criteria",
    "drift",
    "changeset",
    "scope",
    "readiness",
    "page",
    "analysis",
    "diagnostics",
    "limits",
    "inputs",
    "policyEvaluation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "capability-graph"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["complete", "incomplete"]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "paths", "base"],
      "properties": {
        "feature": {
          "type": ["string", "null"]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base": {
          "type": ["string", "null"]
        }
      }
    },
    "affectedFeatureIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effectiveRisk": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "verificationTargets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "featureId", "facts", "sources"],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "feature",
              "source",
              "invariant",
              "criterion",
              "target",
              "decision",
              "work",
              "proof",
              "review"
            ]
          },
          "label": {
            "type": "string"
          },
          "featureId": {
            "type": ["string", "null"]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "pointer", "sha256", "revision"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "relation", "origin", "sources"],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "origin": {
            "enum": ["maintained", "observed", "candidate"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "pointer", "sha256", "revision"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "criterionId",
          "criterion",
          "workId",
          "proof",
          "status",
          "qualifies",
          "assurance",
          "diagnostics",
          "sources"
        ],
        "properties": {
          "featureId": {
            "type": "string"
          },
          "criterionId": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "workId": {
            "type": ["string", "null"]
          },
          "proof": {
            "type": ["string", "null"]
          },
          "status": {
            "enum": [
              "missing",
              "unknown",
              "failed",
              "stale",
              "invalid",
              "unrelated",
              "technical",
              "accepted"
            ]
          },
          "qualifies": {
            "type": "boolean"
          },
          "assurance": {
            "enum": ["declared-only", "git-complete", "unknown"]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "pointer", "sha256", "revision"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "field", "before", "after", "sources"],
        "properties": {
          "featureId": {
            "type": ["string", "null"]
          },
          "field": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "pointer", "sha256", "revision"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "revision": {
                  "type": ["string", "null"]
                }
              }
            }
          }
        }
      }
    },
    "changeset": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "assurance",
            "status",
            "base",
            "head",
            "gitVersion",
            "repository",
            "indexSha256",
            "workingSha256",
            "layers",
            "endpoints",
            "exclusions",
            "fingerprint"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1"
            },
            "assurance": {
              "const": "git-complete"
            },
            "status": {
              "const": "complete"
            },
            "base": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "gitVersion": {
              "type": "string"
            },
            "repository": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "gitDirectory", "commonDirectory", "identity"],
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                },
                "gitDirectory": {
                  "type": "string",
                  "minLength": 1
                },
                "commonDirectory": {
                  "type": "string",
                  "minLength": 1
                },
                "identity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "indexSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "workingSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "layers": {
              "type": "array",
              "maxItems": 120000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["layer", "status", "paths"],
                "properties": {
                  "layer": {
                    "enum": ["committed", "staged", "unstaged", "untracked"]
                  },
                  "status": {
                    "enum": ["added", "modified", "deleted", "type-changed", "renamed"]
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "similarity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            },
            "endpoints": {
              "type": "array",
              "maxItems": 30000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "excluded", "before", "after"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "excluded": {
                    "type": "boolean"
                  },
                  "before": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["object", "mode"],
                        "properties": {
                          "object": {
                            "type": "string",
                            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                          },
                          "mode": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "after": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["sha256", "mode"],
                        "properties": {
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "mode": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": ["object", "null"]
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "identity", "dimensions", "eligibility"],
        "properties": {
          "path": {
            "type": "string"
          },
          "identity": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "status",
                "reason",
                "sources",
                "dependsOn",
                "remediation"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "passed",
                    "failed",
                    "incomplete",
                    "blocked",
                    "not-evaluated",
                    "unsupported"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["path"],
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "recordedAt": {
                        "type": "string"
                      }
                    }
                  }
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "remediation": {
                  "type": "string"
                }
              }
            }
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "readyForAgent",
              "humanControlledExecution",
              "readyForReview",
              "completed",
              "autonomous"
            ],
            "properties": {
              "readyForAgent": {
                "type": ["boolean", "null"]
              },
              "humanControlledExecution": {
                "type": ["boolean", "null"]
              },
              "readyForReview": {
                "type": ["boolean", "null"]
              },
              "completed": {
                "type": ["boolean", "null"]
              },
              "autonomous": {
                "type": ["boolean", "null"]
              }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "limit", "totalNodes", "nextCursor"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "totalNodes": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": ["string", "null"]
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gaps"],
      "properties": {
        "status": {
          "const": "not-evaluated"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "workItems",
        "nodes",
        "edges",
        "fileBytes",
        "metadataBytes",
        "page",
        "criterionRecords",
        "drift",
        "outputBytes"
      ],
      "properties": {
        "features": {
          "const": 2000
        },
        "workItems": {
          "const": 64
        },
        "nodes": {
          "const": 20000
        },
        "edges": {
          "const": 50000
        },
        "fileBytes": {
          "const": 1048576
        },
        "metadataBytes": {
          "const": 67108864
        },
        "page": {
          "const": 1000
        },
        "criterionRecords": {
          "const": 20000
        },
        "drift": {
          "const": 20000
        },
        "outputBytes": {
          "const": 16777216
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "pointer", "sha256", "revision"],
        "properties": {
          "path": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "policyEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "baseline", "limitations"],
      "properties": {
        "mode": {
          "enum": ["candidate-only", "protected-transition"]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "sha256"],
              "properties": {
                "root": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
