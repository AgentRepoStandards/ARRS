{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/adoption-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "status",
    "input",
    "snapshots",
    "discovery",
    "blockers",
    "checklist",
    "operations",
    "remainingChecks",
    "inputPath"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "adoption-proposal"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": ["blocked", "ready-for-review"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 12
        },
        "owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "entryPoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "implementation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "boundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domainTerms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "invariants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "sensitivity": {
          "enum": ["none", "internal", "sensitive", "critical"]
        },
        "acceptance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "risk": {
          "enum": ["R0", "R1", "R2", "R3", "R4"]
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schemaVersion": {
          "const": "0.1"
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": {
            "target": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "command": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argv"],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              }
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modules"],
          "properties": {
            "modules": {
              "type": "array",
              "description": "An empty collection is valid unconfigured adoption state; architecture checks require real configured modules and do not award capability for it.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "allows", "public"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allows": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "public": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "generated": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "sensitivePaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "risk", "reason"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "enum": ["R0", "R1", "R2", "R3", "R4"]
              },
              "reason": {
                "type": "string",
                "minLength": 12
              }
            }
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "name", "supplied", "detail"],
        "properties": {
          "kind": {
            "enum": [
              "manifest",
              "script",
              "instruction",
              "configured-command",
              "configured-target"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "supplied": {
            "const": false
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "remediation"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "remediation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": ["configured", "proposed", "decision", "remaining"]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason", "expected", "replacement"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["sha256", "bytesBase64", "mode"],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytesBase64": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "replacement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "bytesBase64", "mode"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytesBase64": {
                "type": "string"
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            }
          }
        }
      }
    },
    "remainingChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "inputPath": {
      "type": "string",
      "minLength": 1
    }
  }
}
