{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/prepare-scenarios.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "criterion", "beforeExitCode", "afterExitCode"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "beforeExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "afterExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
