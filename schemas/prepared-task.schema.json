{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/prepared-task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "status",
    "objective",
    "category",
    "acceptance",
    "dependencies",
    "decisions",
    "selectionRule",
    "scope",
    "features",
    "inventory",
    "documents",
    "omitted",
    "blockers",
    "requirements",
    "drafts",
    "limits",
    "warnings",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "prepared-task"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": ["draft", "blocked", "human-required"]
    },
    "objective": {
      "type": "string"
    },
    "category": {
      "enum": ["feature", "bug", "refactor", "docs"]
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectionRule": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "selected", "map", "path", "source"],
        "properties": {
          "id": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "map": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "id",
              "goal",
              "owners",
              "entryPoints",
              "implementation",
              "boundaries",
              "dependencies",
              "domainTerms",
              "invariants",
              "sensitivity",
              "acceptance",
              "verification",
              "risk",
              "related"
            ],
            "properties": {
              "schemaVersion": {
                "const": "0.1"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
              },
              "goal": {
                "type": "string",
                "minLength": 12
              },
              "owners": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "entryPoints": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "implementation": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "boundaries": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "domainTerms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "invariants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sensitivity": {
                "enum": ["none", "internal", "sensitive", "critical"]
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target"],
                "properties": {
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "risk": {
                "enum": ["R0", "R1", "R2", "R3", "R4"]
              },
              "related": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "path": {
            "type": "string"
          },
          "source": {
            "enum": ["candidate", "baseline"]
          }
        }
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "bytes", "reasons", "provenance"],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "const": "file"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "text"],
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedRisk",
        "risk",
        "policyEvaluation",
        "autonomy",
        "authorizationRequired",
        "independentReviewRequired",
        "humanAcceptanceRequired",
        "requiredChecks",
        "verificationTargets",
        "commands"
      ],
      "properties": {
        "requestedRisk": {
          "enum": ["R0", "R1", "R2", "R3", "R4"]
        },
        "risk": {
          "enum": ["R0", "R1", "R2", "R3", "R4"]
        },
        "policyEvaluation": {
          "type": "string"
        },
        "policyBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "sha256"],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "limitation": {
          "type": "string"
        },
        "autonomy": {
          "enum": ["unattended", "review", "human"]
        },
        "authorizationRequired": {
          "type": "boolean"
        },
        "independentReviewRequired": {
          "type": "boolean"
        },
        "humanAcceptanceRequired": {
          "type": "boolean"
        },
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verificationTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "argv", "timeoutSeconds"],
            "properties": {
              "command": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutSeconds": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "drafts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "proofProposal", "validationErrors"],
      "properties": {
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "id",
            "title",
            "state",
            "risk",
            "category",
            "featureIds",
            "acceptance",
            "context",
            "verificationTargets",
            "dependencies",
            "decisions"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "needs-triage",
                "needs-information",
                "ready-for-agent",
                "in-progress",
                "verification-failed",
                "ready-for-review",
                "human-required",
                "completed",
                "rejected"
              ]
            },
            "risk": {
              "enum": ["R0", "R1", "R2", "R3", "R4"]
            },
            "category": {
              "enum": ["bug", "feature", "refactor", "docs"]
            },
            "featureIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acceptance": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "context": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verificationTargets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "proof": {
              "type": "string",
              "minLength": 1
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["independent"],
              "properties": {
                "independent": {
                  "type": "string",
                  "minLength": 12
                },
                "humanApproval": {
                  "type": "string",
                  "minLength": 12
                }
              }
            },
            "authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["humanApproval"],
              "properties": {
                "humanApproval": {
                  "type": "string",
                  "minLength": 12
                }
              }
            },
            "policyBaseline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "sha256"],
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "task",
            "category",
            "risk",
            "scope",
            "acceptance",
            "steps",
            "residualRisks",
            "deviations"
          ],
          "properties": {
            "schemaVersion": {
              "const": "0.1"
            },
            "task": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": ["bug", "feature", "refactor", "docs"]
            },
            "risk": {
              "enum": ["R0", "R1", "R2", "R3", "R4"]
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acceptance": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase", "command", "expectExitCode"],
                "properties": {
                  "phase": {
                    "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
                  },
                  "command": {
                    "enum": ["setup", "dev", "check", "test", "verify", "build"]
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectExitCode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "residualRisks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "deviations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["independent"],
              "properties": {
                "independent": {
                  "type": "string",
                  "minLength": 12
                },
                "humanApproval": {
                  "type": "string",
                  "minLength": 12
                }
              }
            },
            "authorization": {
              "type": "object",
              "additionalProperties": false,
              "required": ["humanApproval"],
              "properties": {
                "humanApproval": {
                  "type": "string",
                  "minLength": 12
                }
              }
            },
            "policyBaseline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["root", "sha256"],
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "proofProposal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "missingFields"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["phase", "command", "expectExitCode"],
                "properties": {
                  "phase": {
                    "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
                  },
                  "command": {
                    "enum": ["setup", "dev", "check", "test", "verify", "build"]
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectExitCode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "missingFields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "validationErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "dependencyDepth",
        "documents",
        "navigationDepth",
        "documentBytes",
        "inventoryFiles",
        "fileBytes",
        "inventoryBytes"
      ],
      "properties": {
        "features": {
          "type": "integer",
          "minimum": 0
        },
        "dependencyDepth": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "navigationDepth": {
          "type": "integer",
          "minimum": 0
        },
        "documentBytes": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryFiles": {
          "type": "integer",
          "minimum": 0
        },
        "fileBytes": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "criterion", "beforeExitCode", "afterExitCode"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "beforeExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "afterExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  }
}
