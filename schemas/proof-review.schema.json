{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/proof-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "proofId",
    "manifestSha256",
    "scopeHashes",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "stage": {
      "const": "implementation"
    },
    "proofId": {
      "type": "string",
      "minLength": 1
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopeHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "independent": {
      "type": "string",
      "minLength": 12
    },
    "humanApproval": {
      "type": "string",
      "minLength": 12
    },
    "policyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha256"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
