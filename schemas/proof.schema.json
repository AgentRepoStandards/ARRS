{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "category",
    "risk",
    "scope",
    "acceptance",
    "steps",
    "residualRisks",
    "deviations",
    "id",
    "createdAt",
    "status",
    "results",
    "scopeHashes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["bug", "feature", "refactor", "docs"]
    },
    "risk": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "command", "expectExitCode"],
        "properties": {
          "phase": {
            "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
          },
          "command": {
            "enum": ["setup", "dev", "check", "test", "verify", "build"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "expectExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "residualRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent"],
      "properties": {
        "independent": {
          "type": "string",
          "minLength": 12
        },
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "command",
          "expectExitCode",
          "argv",
          "exitCode",
          "durationMs",
          "log",
          "sha256"
        ],
        "properties": {
          "phase": {
            "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
          },
          "command": {
            "enum": ["setup", "dev", "check", "test", "verify", "build"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "expectExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "log": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "scopeHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanApproval"],
      "properties": {
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "policyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha256"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "changeset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "base"],
      "properties": {
        "version": {
          "const": "1"
        },
        "mode": {
          "const": "git"
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "changesetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assurance",
        "status",
        "base",
        "head",
        "gitVersion",
        "repository",
        "indexSha256",
        "workingSha256",
        "layers",
        "endpoints",
        "exclusions",
        "fingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "assurance": {
          "const": "git-complete"
        },
        "status": {
          "const": "complete"
        },
        "base": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "gitVersion": {
          "type": "string"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "gitDirectory", "commonDirectory", "identity"],
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "gitDirectory": {
              "type": "string",
              "minLength": 1
            },
            "commonDirectory": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "indexSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "workingSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "layers": {
          "type": "array",
          "maxItems": 120000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "status", "paths"],
            "properties": {
              "layer": {
                "enum": ["committed", "staged", "unstaged", "untracked"]
              },
              "status": {
                "enum": ["added", "modified", "deleted", "type-changed", "renamed"]
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "similarity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "endpoints": {
          "type": "array",
          "maxItems": 30000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "excluded", "before", "after"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "excluded": {
                "type": "boolean"
              },
              "before": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["object", "mode"],
                    "properties": {
                      "object": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "mode": {
                        "type": "string"
                      }
                    }
                  }
                ]
              },
              "after": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["sha256", "mode"],
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "mode": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
