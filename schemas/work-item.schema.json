{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/work-item.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "state",
    "risk",
    "category",
    "featureIds",
    "acceptance",
    "context",
    "verificationTargets",
    "dependencies",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "needs-triage",
        "needs-information",
        "ready-for-agent",
        "in-progress",
        "verification-failed",
        "ready-for-review",
        "human-required",
        "completed",
        "rejected"
      ]
    },
    "risk": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "category": {
      "enum": ["bug", "feature", "refactor", "docs"]
    },
    "featureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent"],
      "properties": {
        "independent": {
          "type": "string",
          "minLength": 12
        },
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanApproval"],
      "properties": {
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "policyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha256"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
