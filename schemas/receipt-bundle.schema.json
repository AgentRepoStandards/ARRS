{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/1/receipt-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "assurance",
    "proofId",
    "manifestSha256",
    "technicalPassed",
    "acceptedLocal",
    "scope",
    "commands",
    "acceptance",
    "category"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "local-receipt-bundle"
    },
    "assurance": {
      "const": "local-integrity"
    },
    "proofId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "technicalPassed": {
      "type": "boolean"
    },
    "acceptedLocal": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance"],
      "properties": {
        "assurance": {
          "enum": ["declared-only", "git-complete"]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "phase",
          "argvSha256",
          "timeoutSeconds",
          "exitCode",
          "execution",
          "logSha256",
          "expectExitCode"
        ],
        "properties": {
          "command": {
            "enum": ["setup", "dev", "check", "test", "verify", "build"]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "phase": {
            "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
          },
          "argvSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "exitCode": {
            "type": "integer"
          },
          "execution": {
            "enum": ["executed", "skipped", "unsupported"]
          },
          "logSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectExitCode": {
            "type": "integer"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionSha256", "resultIndices"],
        "properties": {
          "criterionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resultIndices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          }
        }
      }
    },
    "category": {
      "enum": ["feature", "bug", "refactor", "docs"]
    }
  }
}
