{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/1/receipt-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "revision",
    "comparisonBase",
    "runId",
    "attemptId",
    "manifestSha256",
    "controlsSha256",
    "role",
    "actorId",
    "reviewId",
    "state",
    "sequence",
    "submittedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "github-offline-review"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "comparisonBase": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "attemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": ["independent", "humanAcceptance"]
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "state": {
      "enum": ["APPROVED", "CHANGES_REQUESTED", "DISMISSED"]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "submittedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30
    }
  }
}
