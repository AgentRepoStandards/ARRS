{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "tool",
    "status",
    "identity",
    "data",
    "items",
    "page",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "mcp-inspection"
    },
    "tool": {
      "type": "string"
    },
    "status": {
      "enum": ["ok", "blocked", "error"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source", "result", "policyMode"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "policyMode": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "index", "value"],
        "properties": {
          "section": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "value": {}
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "total", "complete"],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "nextCursor": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recovery"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawLogs", "sourceContents", "retentionMs"],
      "properties": {
        "rawLogs": {
          "const": false
        },
        "sourceContents": {
          "type": "boolean"
        },
        "retentionMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "https://arrs.dev/schemas/0.1/mcp-inspection.schema.json"
}
