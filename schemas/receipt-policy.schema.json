{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/1/receipt-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "provider",
    "repository",
    "verifier",
    "providerAuthority",
    "reviewAuthority",
    "allowedTriggers",
    "reviewers",
    "maximumAgeSeconds",
    "allowInspectionReuse"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "kind": {
      "const": "receipt-consumer-policy"
    },
    "provider": {
      "const": "github-offline-v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keyId", "publicKey", "workflow", "toolSha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "publicKey": {
          "type": "string",
          "minLength": 50,
          "maxLength": 1000
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "revision"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
            },
            "revision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          }
        },
        "toolSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "providerAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keyId", "publicKey"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "publicKey": {
          "type": "string",
          "minLength": 50,
          "maxLength": 1000
        }
      }
    },
    "reviewAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keyId", "publicKey"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "publicKey": {
          "type": "string",
          "minLength": 50,
          "maxLength": 1000
        }
      }
    },
    "allowedTriggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "enum": ["pull_request", "workflow_dispatch"]
      }
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "humanAcceptance"],
      "properties": {
        "independent": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "humanAcceptance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "maximumAgeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "allowInspectionReuse": {
      "type": "boolean"
    }
  }
}
