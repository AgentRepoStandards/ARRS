{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/risk.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classes", "sensitivePaths"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R0", "R1", "R2", "R3", "R4"],
      "properties": {
        "R0": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "requiredChecks",
            "independentReview",
            "humanApproval"
          ],
          "properties": {
            "autonomy": {
              "enum": ["unattended", "review", "human"]
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "dev", "check", "test", "verify", "build"]
              }
            },
            "independentReview": {
              "type": "boolean"
            },
            "humanApproval": {
              "type": "boolean"
            }
          }
        },
        "R1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "requiredChecks",
            "independentReview",
            "humanApproval"
          ],
          "properties": {
            "autonomy": {
              "enum": ["unattended", "review", "human"]
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "dev", "check", "test", "verify", "build"]
              }
            },
            "independentReview": {
              "type": "boolean"
            },
            "humanApproval": {
              "type": "boolean"
            }
          }
        },
        "R2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "requiredChecks",
            "independentReview",
            "humanApproval"
          ],
          "properties": {
            "autonomy": {
              "enum": ["unattended", "review", "human"]
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "dev", "check", "test", "verify", "build"]
              }
            },
            "independentReview": {
              "type": "boolean"
            },
            "humanApproval": {
              "type": "boolean"
            }
          }
        },
        "R3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "requiredChecks",
            "independentReview",
            "humanApproval"
          ],
          "properties": {
            "autonomy": {
              "enum": ["unattended", "review", "human"]
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "dev", "check", "test", "verify", "build"]
              }
            },
            "independentReview": {
              "type": "boolean"
            },
            "humanApproval": {
              "type": "boolean"
            }
          }
        },
        "R4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "requiredChecks",
            "independentReview",
            "humanApproval"
          ],
          "properties": {
            "autonomy": {
              "enum": ["unattended", "review", "human"]
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["setup", "dev", "check", "test", "verify", "build"]
              }
            },
            "independentReview": {
              "type": "boolean"
            },
            "humanApproval": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "sensitivePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "risk", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": ["R0", "R1", "R2", "R3", "R4"]
          },
          "reason": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    }
  }
}
