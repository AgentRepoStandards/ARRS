{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/proof-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "task",
    "category",
    "risk",
    "scope",
    "acceptance",
    "steps",
    "residualRisks",
    "deviations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["bug", "feature", "refactor", "docs"]
    },
    "risk": {
      "enum": ["R0", "R1", "R2", "R3", "R4"]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "command", "expectExitCode"],
        "properties": {
          "phase": {
            "enum": ["before", "check", "test", "behavior", "after", "mechanical"]
          },
          "command": {
            "enum": ["setup", "dev", "check", "test", "verify", "build"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "expectExitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "residualRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent"],
      "properties": {
        "independent": {
          "type": "string",
          "minLength": 12
        },
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanApproval"],
      "properties": {
        "humanApproval": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "policyBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha256"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "changeset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "base"],
      "properties": {
        "version": {
          "const": "1"
        },
        "mode": {
          "const": "git"
        },
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
