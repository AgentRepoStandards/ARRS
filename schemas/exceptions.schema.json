{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arrs.dev/schemas/0.1/exceptions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exceptions", "dependencies"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "rule", "match", "reason", "expires", "approvedBy"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "enum": ["suppression", "remote-execution"]
          },
          "match": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 12
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    }
  }
}
